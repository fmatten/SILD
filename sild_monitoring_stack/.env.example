# SILD Referenz-Stack — Umgebungsvariablen
#
# Nutzung:
#   cp .env.example .env
#   und in der .env einen eigenen Wert vergeben.
#
# Die .env selbst gehoert nicht ins Repository (siehe .gitignore).

# Grafana-Admin-Passwort. Pflicht — ohne diesen Wert startet der Stack nicht.
# Der Stack bringt bewusst keinen Vorgabewert mit.
GF_SECURITY_ADMIN_PASSWORD=
